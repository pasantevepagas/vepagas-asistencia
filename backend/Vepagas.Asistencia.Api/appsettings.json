{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Asistencia": "Data Source=App_Data/asistencia.db"
  },

  "//": "NO poner secretos aquí. Graph:ClientSecret, Auth:ClaveFirmaJwt y Auth:ClaveAdmin van en user-secrets (dev) o variables de entorno (IIS).",

  "Graph": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": ""
  },

  "SharePoint": {
    "Modo": "Real",
    "SiteId": "",
    "ListaRegistrosId": "",
    "ListaUbicacionesId": "",
    "ListaDispositivosId": "",
    "ListaSesionesId": "",
    "ListaUbicacionAppId": "",
    "CoordenadasComoNumero": false,
    "CoordenadasConComaDecimal": true,
    "FormatoFechaTexto": "d MMMM yyyy H:mm",
    "CulturaFechaTexto": "es-EC",
    "FechaTextoEnHoraLocal": true,
    "CamposRegistro": {
      "IdUsuario": "ID_USUARIO",
      "FechaHoraInicio": "FECHA_HORA_INICIO",
      "FechaHoraSalida": "FECHA_HORA_SALIDA",
      "IdReg": "ID_REG",
      "TipoTrabajo": "TIPO_TRABAJO"
    },
    "CamposUbicacion": {
      "IdFecha": "ID_FECHA",
      "Hora": "HORA",
      "Lat": "LAT",
      "Long": "LONG",
      "Ubicacion": "UBICACION"
    }
  },

  "Auth": {
    "GoogleClientIds": [],
    "ClaveFirmaJwt": "",
    "Emisor": "vepagas-asistencia",
    "DuracionSesionHoras": 12,
    "ClaveAdmin": "",
    "PermitirLoginDesarrollo": false
  },

  "Asistencia": {
    "ZonaHoraria": "America/Guayaquil",
    "TiposTrabajo": [ "Home_Office" ],
    "EtiquetasTiposTrabajo": { "Home_Office": "Tele trabajo" },
    "PrecisionMaximaMetros": 100,
    "MinutosReconciliacion": 2,
    "IntentosMaximosUbicacion": 30,
    "ControlDispositivos": true,
    "MigrarDispositivosPowerApps": true,
    "RegistrarUbicacionApp": true
  }
}
