<?xml version="1.0" encoding="utf-8"?>
<!-- No respaldar ni transferir la sesión (está cifrada con una clave del Keystore que no viaja). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
